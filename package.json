    "format": "wp-scripts format",
    "packages-update": "wp-scripts packages-update",
    "build:package": "node ./build-package.js",
    "prepare": "husky install"
  },
  "dependencies": {
    "@stripe/stripe-js": "^7.0.0",
    "chart.js": "^4.5.0",
    "immer": "^10.1.3",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0",
    "@wordpress/element": "^6.31.0",
    "archiver": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "webpack-cli": "^5.1.4",
    "sass-loader": "^14.2.1",
    "css-loader": "^7.1.2",
    "style-loader": "^4.0.0",
    "sass": "^1.78.0"
  },
  "lint-staged": {
    "*.php": [
      "vendor/bin/phpcbf",
      "vendor/bin/phpcs"
